---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/AuthShell.astro";
import ProfileForm from "@/components/profile/ProfileForm";
import { createClient } from "@/lib/supabase";
import { getProfile } from "@/lib/profile";

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
const saved = Astro.url.searchParams.get("saved") === "1";

let initial = { sex: null as string | null, blood_group: null as string | null, rh: null as string | null };

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase && user) {
  const profile = await getProfile(supabase, user.id);
  if (profile) {
    initial = { sex: profile.sex, blood_group: profile.blood_group, rh: profile.rh };
  }
}
---

<Layout title="Twój profil">
  <AuthShell>
    <div
      class="mx-auto mt-6 w-full max-w-sm rounded-2xl p-8 text-white"
      style="border: 1px solid rgba(220,38,38,0.15); background: rgba(255,255,255,0.03); backdrop-filter: blur(16px);"
    >
      <h1
        class="mb-6 text-center text-2xl font-bold"
        style="background: linear-gradient(135deg, #fecaca 0%, #f87171 40%, #ef4444 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
      >
        Twój profil
      </h1>
      <ProfileForm initial={initial} serverError={error} saved={saved} client:load />
    </div>
  </AuthShell>
</Layout>
