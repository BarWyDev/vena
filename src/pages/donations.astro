---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/AuthShell.astro";
import DonationForm from "@/components/donations/DonationForm";
import EligibilityCards from "@/components/donations/EligibilityCards";
import { createClient } from "@/lib/supabase";
import { getProfile } from "@/lib/profile";
import { getDonations, getLatestPerType, getLatestIds } from "@/lib/donations";
import type { DonationRow } from "@/lib/donations";
import DonationHistory from "@/components/donations/DonationHistory";
import { calculateEligibility, DONATION_TYPES } from "@/lib/eligibility";
import type { EligibilityResult, DonationType } from "@/lib/eligibility";

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");
const added = Astro.url.searchParams.get("added") === "1";
const edited = Astro.url.searchParams.get("edited") === "1";
const deleted = Astro.url.searchParams.get("deleted") === "1";
const typeRaw = Astro.url.searchParams.get("type");
const typeParam: DonationType | null = DONATION_TYPES.includes(typeRaw as DonationType)
  ? (typeRaw as DonationType)
  : null;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let donations: DonationRow[] = [];
let eligibility: EligibilityResult | null = null;

if (supabase && user) {
  const [profile, donationsData] = await Promise.all([getProfile(supabase, user.id), getDonations(supabase, user.id)]);
  donations = donationsData;
  if (profile?.sex) {
    eligibility = calculateEligibility(getLatestPerType(donations), profile.sex);
  }
}

const hasDonations = donations.length > 0;
const latestIds = getLatestIds(donations);
---

<Layout title="Moje donacje">
  <AuthShell>
    <div
      class="mx-auto mt-6 w-full max-w-2xl rounded-2xl p-8 text-white"
      style="border: 1px solid rgba(220,38,38,0.15); background: rgba(255,255,255,0.03); backdrop-filter: blur(16px);"
    >
      {
        edited && (
          <p class="mb-4 rounded-lg border border-green-500/30 bg-green-900/30 px-3 py-2 text-sm text-green-300">
            Donacja zaktualizowana
          </p>
        )
      }
      {
        deleted && (
          <p class="mb-4 rounded-lg border border-green-500/30 bg-green-900/30 px-3 py-2 text-sm text-green-300">
            Donacja usunięta
          </p>
        )
      }

      <h1
        class="mb-6 text-center text-2xl font-bold"
        style="background: linear-gradient(135deg, #fecaca 0%, #f87171 40%, #ef4444 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
      >
        Moje donacje
      </h1>

      {
        !hasDonations && (
          <p class="mb-6 text-center text-sm" style="color: rgba(254,202,202,0.65);">
            Dodaj pierwszą donację, aby zobaczyć kiedy możesz oddać krew następnym razem.
          </p>
        )
      }

      {
        hasDonations && eligibility && (
          <div class="mb-6">
            <EligibilityCards eligibility={eligibility} initialSelectedType={typeParam} client:load />
          </div>
        )
      }

      <DonationForm serverError={error} added={added} client:load />

      {
        hasDonations && (
          <>
            <h2 class="mt-8 mb-4 text-sm font-semibold" style="color: rgba(254,202,202,0.7);">
              Historia donacji
            </h2>
            <DonationHistory donations={donations} latestIds={latestIds} client:load />
          </>
        )
      }
    </div>
  </AuthShell>
</Layout>
