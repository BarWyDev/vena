---
import Layout from "@/layouts/Layout.astro";
import AuthShell from "@/components/AuthShell.astro";
import DonationEditForm from "@/components/donations/DonationEditForm";
import { createClient } from "@/lib/supabase";

const { id } = Astro.params;
const { user } = Astro.locals;

const supabase = createClient(Astro.request.headers, Astro.cookies);

let data = null;
if (supabase && id && user) {
  const result = await supabase.from("donations").select().eq("id", id).eq("user_id", user.id).maybeSingle();
  data = result.data;
}

if (!data) {
  Astro.response.status = 302;
  Astro.response.headers.set("Location", "/donations");
}

const error = Astro.url.searchParams.get("error");
---

<Layout title="Edytuj donację">
  <AuthShell>
    <div
      class="mx-auto mt-6 w-full max-w-sm rounded-2xl p-8 text-white"
      style="border: 1px solid rgba(220,38,38,0.15); background: rgba(255,255,255,0.03); backdrop-filter: blur(16px);"
    >
      <h1
        class="mb-6 text-center text-2xl font-bold"
        style="background: linear-gradient(135deg, #fecaca 0%, #f87171 40%, #ef4444 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
      >
        Edytuj donację
      </h1>
      {data && <DonationEditForm donation={data} serverError={error} client:load />}
    </div>
  </AuthShell>
</Layout>
